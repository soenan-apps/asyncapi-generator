{
  "name": "@soenan/asyncapi-generator",
  "version": "0.1.0",
  "description": "Deterministic AsyncAPI 3.1 Swift and Dart generator",
  "license": "Apache-2.0",
  "author": "Soenan LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soenan-apps/asyncapi-generator.git"
  },
  "bugs": {
    "url": "https://github.com/soenan-apps/asyncapi-generator/issues"
  },
  "homepage": "https://github.com/soenan-apps/asyncapi-generator#readme",
  "keywords": [
    "asyncapi",
    "code-generation",
    "dart",
    "swift",
    "websocket"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "asyncapi-soenan-generator": "./bin/asyncapi-soenan-generator.mjs"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "asyncapi-generator.schema.json",
    "bin",
    "src",
    "template/package.json",
    "template/src",
    "template/template"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "template"
  ],
  "scripts": {
    "test": "mise x node@24.11.1 -- node --test --test-reporter=spec test/unit/*.test.mjs test/integration/*.test.mjs",
    "test:unit": "mise x node@24.11.1 -- node --test --test-reporter=spec test/unit/*.test.mjs",
    "test:integration": "mise x node@24.11.1 -- node --test --test-reporter=spec test/integration/*.test.mjs",
    "check": "npm test"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "dependencies": {
    "@asyncapi/generator": "3.3.0",
    "@asyncapi/parser": "3.6.1"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.9",
    "jsonpath-plus": "10.4.0",
    "minimatch": "10.2.6"
  }
}
