{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Soenan AsyncAPI generator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "targets"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "moduleName",
          "output"
        ],
        "properties": {
          "language": {
            "enum": [
              "swift",
              "dart"
            ]
          },
          "moduleName": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "output": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
