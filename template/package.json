{
  "name": "@soenan/asyncapi-generator-template",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@asyncapi/generator-react-sdk": "1.1.3"
  },
  "generator": {
    "renderer": "react",
    "apiVersion": "v3",
    "generator": ">=3.3.0 <4.0.0",
    "parameters": {
      "language": {
        "description": "Target language: swift or dart",
        "required": true
      },
      "moduleName": {
        "description": "Public generated API namespace",
        "required": true
      }
    }
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ],
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ]
    ]
  }
}
